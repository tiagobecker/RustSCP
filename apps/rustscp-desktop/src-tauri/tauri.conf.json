{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSCP",
  "version": "0.1.0",
  "identifier": "com.rustscp.desktop",
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Next-Gen Remote Workspace, SFTP/SCP/S3 Client & AI Gateway",
    "longDescription": "RustSCP is a modern remote workspace, SFTP, SCP, and S3 file manager with integrated AI Gateway (MCP) built with Rust and Tauri v2.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RustSCP",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
